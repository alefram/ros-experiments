<?xml version="1.0" ?>
<!-- Static camera used to record the experiments (spawned optionally by the launch files). -->
<sdf version="1.8">
  <model name="video_camera">
    <static>true</static>
    <!-- The pose is set by the launch file (ros_gz_sim create overrides it):
         from (1.7, 1.7, 1.5) towards (0.5, 0.1, 0.45) -->
    <link name="link">
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>video_cam/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
