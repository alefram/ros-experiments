<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5_robot">
   <!-- robot name parameter -->
   <xacro:arg name="name" default="ur"/>
   <xacro:arg name="tf_prefix" default="" />
   
   <!-- Ignition/Gazebo parameters -->
   <xacro:arg name="sim_ignition" default="true" />
   <xacro:arg name="simulation_controllers" default="$(find ur5_setup)/config/ur_controllers.yaml" />

   <!-- import main macro -->
   <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

   <!-- parameters -->
   <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/ur5/joint_limits.yaml"/>
   <xacro:arg name="kinematics_params" default="$(find ur_description)/config/ur5/default_kinematics.yaml"/>
   <xacro:arg name="physical_params" default="$(find ur_description)/config/ur5/physical_parameters.yaml"/>
   <xacro:arg name="visual_params" default="$(find ur_description)/config/ur5/visual_parameters.yaml"/>
   <xacro:arg name="safety_limits" default="false"/>
   <xacro:arg name="safety_pos_margin" default="0.15"/>
   <xacro:arg name="safety_k_position" default="20"/>

   <!-- Robot parent link -->
   <link name="world"/>

   <!-- The Arm -->
   <xacro:ur_robot
     name="$(arg name)"
     tf_prefix="$(arg tf_prefix)"
     parent="world"
     joint_limits_parameters_file="$(arg joint_limit_params)"
     kinematics_parameters_file="$(arg kinematics_params)"
     physical_parameters_file="$(arg physical_params)"
     visual_parameters_file="$(arg visual_params)"
     force_abs_paths="$(arg sim_ignition)"
     safety_limits="$(arg safety_limits)"
     safety_pos_margin="$(arg safety_pos_margin)"
     safety_k_position="$(arg safety_k_position)">
     <origin xyz="0 0 0" rpy="0 0 0" />
   </xacro:ur_robot>

   <!-- Suction Cup Tool -->
   <link name="suction_cup">
     <visual>
       <origin xyz="0 0 0.025" rpy="0 0 0"/>
       <geometry><cylinder radius="0.03" length="0.05"/></geometry>
       <material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>
     </visual>
     <collision name="suction_cup_collision">
       <origin xyz="0 0 0.025" rpy="0 0 0"/>
       <geometry><cylinder radius="0.03" length="0.05"/></geometry>
     </collision>
     <inertial>
       <mass value="0.2"/>
       <origin xyz="0 0 0.025" rpy="0 0 0"/>
       <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
     </inertial>
   </link>

   <joint name="suction_cup_joint" type="fixed">
     <parent link="tool0"/>
     <child link="suction_cup"/>
     <origin xyz="0 0 0" rpy="0 0 0"/>
   </joint>

   <!-- Keep the suction cup as its own link in SDF (otherwise Gazebo lumps it into
        wrist_3_link and the DetachableJoint plugin cannot find 'suction_cup') -->
   <gazebo reference="suction_cup_joint">
     <preserveFixedJoint>true</preserveFixedJoint>
   </gazebo>

   <!-- Suction Cup TCP -->
   <link name="suction_cup_tcp"/>
   <joint name="suction_cup_tcp_joint" type="fixed">
     <parent link="suction_cup"/>
     <child link="suction_cup_tcp"/>
     <origin xyz="0 0 0.05" rpy="0 0 0"/>
   </joint>

   <!-- ros2_control hardware interface (Gazebo Sim) -->
   <ros2_control name="GazeboSimSystem" type="system">
     <hardware>
       <plugin>gz_ros2_control/GazeboSimSystem</plugin>
     </hardware>
     <xacro:macro name="ur_joint_interface" params="joint initial_value">
       <joint name="${joint}">
         <command_interface name="position"/>
         <state_interface name="position">
           <param name="initial_value">${initial_value}</param>
         </state_interface>
         <state_interface name="velocity"/>
       </joint>
     </xacro:macro>
     <xacro:ur_joint_interface joint="$(arg tf_prefix)shoulder_pan_joint" initial_value="0.0"/>
     <xacro:ur_joint_interface joint="$(arg tf_prefix)shoulder_lift_joint" initial_value="-1.57"/>
     <xacro:ur_joint_interface joint="$(arg tf_prefix)elbow_joint" initial_value="1.57"/>
     <xacro:ur_joint_interface joint="$(arg tf_prefix)wrist_1_joint" initial_value="-1.57"/>
     <xacro:ur_joint_interface joint="$(arg tf_prefix)wrist_2_joint" initial_value="-1.57"/>
     <xacro:ur_joint_interface joint="$(arg tf_prefix)wrist_3_joint" initial_value="0.0"/>
   </ros2_control>

   <gazebo>
     <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
       <parameters>$(arg simulation_controllers)</parameters>
       <controller_manager_prefix_node_name>$(arg tf_prefix)controller_manager</controller_manager_prefix_node_name>
     </plugin>

     <!-- Detachable Joint for Suction Gripper Emulation.
          Starts detached; ros_gz_bridge exposes the attach/detach topics:
            /ur5/detachable_joint/attach  (std_msgs/Empty)
            /ur5/detachable_joint/detach  (std_msgs/Empty)
            /ur5/detachable_joint/state   (std_msgs/Int32, 1=attached)  -->
     <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
       <parent_link>suction_cup</parent_link>
       <child_model>blue_cube</child_model>
       <child_link>cube_link</child_link>
       <attach_topic>/ur5/detachable_joint/attach</attach_topic>
       <detach_topic>/ur5/detachable_joint/detach</detach_topic>
       <output_topic>/ur5/detachable_joint/state</output_topic>
     </plugin>
   </gazebo>

</robot>
